# System-library shims generated by tools/shimgen.py (docs/design/runtime.md, section 2).
#
# x2w_gdk.dll holds the hand-written Gaming Runtime implementations (src/gdk). At configure time shimgen
# writes one shim per console DLL name; each links x2w_gdk and is built into shims/ beside it, the
# directory x2w_launch and tools/x2w_report.py take as --shims. What is generated:
#   - xgameruntime.dll with every spec function (PC GDK titles load it dynamically; x2w_launch's loader
#     hooks route that load to this shim);
#   - the DLLs of a title's import list, when one of these cache variables names its input:
#       X2W_SHIM_REPORT    report.json from tools/x2w_report.py
#       X2W_SHIM_MANIFEST  JSON object: DLL name -> function names
#       X2W_SHIM_RUN_LOG   an x2w_launch --log file (its dynamic-resolve lines)
#     with X2W_SHIM_OVERRIDES (a list of override .toml files) applied;
#   - the test fixture's placeholder DLL (tests/shimgen), built beside the test programs, not in shims/.
set(X2W_SHIM_REPORT "" CACHE FILEPATH "x2w_report.py report.json whose import list tools/shimgen.py turns into shims")
set(X2W_SHIM_MANIFEST "" CACHE FILEPATH "JSON manifest (DLL name -> function names) for tools/shimgen.py")
set(X2W_SHIM_RUN_LOG "" CACHE FILEPATH "x2w_launch --log file whose dynamic-resolve lines tools/shimgen.py turns into shims")
set(X2W_SHIM_OVERRIDES "" CACHE STRING "Override .toml files (;-list) for tools/shimgen.py")

if(EXISTS "${INTAKE_PYTHON}")
    set(x2w_shimgen_python "${INTAKE_PYTHON}")
else()
    find_package(Python3 3.11 COMPONENTS Interpreter)
    if(NOT Python3_Interpreter_FOUND)
        message(FATAL_ERROR "tools/shimgen.py needs Python 3.11 or newer (INTAKE_PYTHON or one on PATH)")
    endif()
    set(x2w_shimgen_python "${Python3_EXECUTABLE}")
endif()

file(GLOB x2w_shimgen_specs CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/tools/shimgen/specs/*.toml")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/tools/shimgen.py" ${x2w_shimgen_specs})

add_library(x2w_gdk SHARED src/gdk/gdk_core.cpp src/gdk/gdk_taskqueue.cpp src/gdk/gdk_async.cpp
    src/gdk/gdk_runtime.cpp src/gdk/gdk_user.cpp src/gdk/gdk_gamesave.cpp src/gdk/gdk_package.cpp
    src/gdk/gdk_gameui.cpp)
target_include_directories(x2w_gdk PUBLIC "${CMAKE_SOURCE_DIR}/src/gdk")
target_compile_features(x2w_gdk PRIVATE cxx_std_17)
target_compile_definitions(x2w_gdk PRIVATE X2W_GDK_EXPORTS)
target_compile_options(x2w_gdk PRIVATE /W4)

# Called by each generated shims.cmake: one shim DLL with the console name OUTPUT_NAME.
function(x2w_generated_shim target output_name source definition)
    add_library(${target} SHARED "${source}" "${definition}")
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output_name}")
    target_compile_features(${target} PRIVATE cxx_std_17)
    target_link_libraries(${target} PRIVATE x2w_gdk)
    if(x2w_shimgen_into_shims)
        set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/shims")
        set_property(GLOBAL APPEND PROPERTY X2W_GENERATED_SHIMS ${target})
    endif()
endfunction()

# Runs shimgen into DIR with the given arguments and adds the DLLs it lists.
function(x2w_shimgen_generate dir)
    execute_process(COMMAND "${x2w_shimgen_python}" -B "${CMAKE_SOURCE_DIR}/tools/shimgen.py" --out "${dir}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "tools/shimgen.py failed:\n${output}")
    endif()
    message(STATUS "shimgen ${dir}:\n${output}")
    include("${dir}/shims.cmake")
endfunction()

set(x2w_shimgen_args --all-specs xgameruntime.dll)
foreach(input IN ITEMS REPORT MANIFEST RUN_LOG)
    if(X2W_SHIM_${input})
        string(TOLOWER "${input}" flag)
        string(REPLACE "_" "-" flag "${flag}")
        list(APPEND x2w_shimgen_args --${flag} "${X2W_SHIM_${input}}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${X2W_SHIM_${input}}")
    endif()
endforeach()
foreach(override IN LISTS X2W_SHIM_OVERRIDES)
    list(APPEND x2w_shimgen_args --override "${override}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${override}")
endforeach()
set(x2w_shimgen_into_shims TRUE)
x2w_shimgen_generate("${CMAKE_BINARY_DIR}/shimgen/runtime" ${x2w_shimgen_args})
set(x2w_shimgen_into_shims FALSE)

get_property(x2w_generated_shims GLOBAL PROPERTY X2W_GENERATED_SHIMS)
add_custom_target(x2w_gdk_shims ALL
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/shims"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:x2w_gdk>" "${CMAKE_BINARY_DIR}/shims"
    DEPENDS x2w_gdk ${x2w_generated_shims} VERBATIM)
if(TARGET x2w_launch)
    add_dependencies(x2w_launch x2w_gdk_shims)
endif()

# ---------------------------------------------------------------- tests
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_SOURCE_DIR}/tests/shimgen/fixture_manifest.json" "${CMAKE_SOURCE_DIR}/tests/shimgen/fixture_override.toml")
x2w_shimgen_generate("${CMAKE_BINARY_DIR}/shimgen/fixture"
    --manifest "${CMAKE_SOURCE_DIR}/tests/shimgen/fixture_manifest.json" --all-specs x2w_shimgen_fixture.dll
    --override "${CMAKE_SOURCE_DIR}/tests/shimgen/fixture_override.toml")
add_library(x2w_shimgen_fakepc SHARED tests/shimgen/fake_pc_runtime.cpp tests/shimgen/fake_pc_runtime.def)
add_executable(shimgen_fixture tests/shimgen/shimgen_fixture.cpp)
target_include_directories(shimgen_fixture PRIVATE "${CMAKE_BINARY_DIR}/shimgen/fixture" "${CMAKE_SOURCE_DIR}/src/gdk")
target_compile_features(shimgen_fixture PRIVATE cxx_std_17)
target_link_libraries(shimgen_fixture PRIVATE x2w_shim_x2w_shimgen_fixture)
add_dependencies(shimgen_fixture x2w_gdk x2w_shimgen_fakepc)
foreach(scenario IN ITEMS taskqueue async user save package gameui stubs forward fallback)
    add_test(NAME shimgen_fixture_${scenario} COMMAND shimgen_fixture ${scenario})
    set_tests_properties(shimgen_fixture_${scenario} PROPERTIES TIMEOUT 60)
endforeach()

add_test(NAME shimgen_generate COMMAND "${x2w_shimgen_python}" -B "${CMAKE_SOURCE_DIR}/tests/shimgen/shimgen_check.py")
set_tests_properties(shimgen_generate PROPERTIES TIMEOUT 60)

if(TARGET x2w_launch)
    # A CRT-free program that loads xgameruntime.dll at run time, as PC GDK builds do, run through
    # x2w_launch: the loader hooks must route it to the generated shim and log the loads and resolves.
    add_executable(x2w_shimgen_dynamic_title tests/shimgen/dynamic_title.cpp)
    target_compile_options(x2w_shimgen_dynamic_title PRIVATE /GS- /Zl)
    target_link_options(x2w_shimgen_dynamic_title PRIVATE /ENTRY:dynamic_entry /NODEFAULTLIB /SUBSYSTEM:CONSOLE
        /DYNAMICBASE /INCREMENTAL:NO)
    target_link_libraries(x2w_shimgen_dynamic_title PRIVATE kernel32)
    add_dependencies(x2w_shimgen_dynamic_title x2w_gdk_shims)
    add_test(NAME shimgen_dynamic_load COMMAND "${x2w_shimgen_python}" -B
        "${CMAKE_SOURCE_DIR}/tests/shimgen/dynamic_check.py" "$<TARGET_FILE:x2w_launch>"
        "$<TARGET_FILE:x2w_shimgen_dynamic_title>" "${CMAKE_BINARY_DIR}/shims")
    set_tests_properties(shimgen_dynamic_load PROPERTIES TIMEOUT 120)
endif()
