OpCapability Shader
OpCapability Int64
OpCapability PhysicalStorageBufferAddresses
OpExtension "SPV_KHR_physical_storage_buffer"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel PhysicalStorageBuffer64 GLSL450
OpEntryPoint GLCompute %main "main" %user_data
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %rt_uint ArrayStride 4
OpDecorate %words ArrayStride 4
OpDecorate %UserData Block
OpMemberDecorate %UserData 0 Offset 0
%void = OpTypeVoid
%bool = OpTypeBool
%uint = OpTypeInt 32 0
%ulong = OpTypeInt 64 0
%fn = OpTypeFunction %void
%c0 = OpConstant %uint 0
%c1 = OpConstant %uint 1
%c2 = OpConstant %uint 2
%c3 = OpConstant %uint 3
%c4 = OpConstant %uint 4
%shift32 = OpConstant %uint 32
%rt_uint = OpTypeRuntimeArray %uint
%_ptr_PSB_arr = OpTypePointer PhysicalStorageBuffer %rt_uint
%_ptr_PSB_uint = OpTypePointer PhysicalStorageBuffer %uint
%words = OpTypeArray %uint %c4
%UserData = OpTypeStruct %words
%_ptr_PC_UserData = OpTypePointer PushConstant %UserData
%_ptr_PC_uint = OpTypePointer PushConstant %uint
%user_data = OpVariable %_ptr_PC_UserData PushConstant
%main = OpFunction %void None %fn
%entry = OpLabel
%u0 = OpAccessChain %_ptr_PC_uint %user_data %c0 %c0
%l0 = OpLoad %uint %u0
%low = OpUConvert %ulong %l0
%highPtr = OpAccessChain %_ptr_PC_uint %user_data %c0 %c3
%highWord = OpLoad %uint %highPtr
%high64 = OpUConvert %ulong %highWord
%shifted = OpShiftLeftLogical %ulong %high64 %shift32
%a0 = OpBitwiseOr %ulong %low %shifted
%v0 = OpConvertUToPtr %_ptr_PSB_arr %a0
%p0 = OpAccessChain %_ptr_PSB_uint %v0 %c1
%u1 = OpAccessChain %_ptr_PC_uint %user_data %c0 %c1
%l1 = OpLoad %uint %u1
%a1 = OpUConvert %ulong %l1
%v1 = OpConvertUToPtr %_ptr_PSB_arr %a1
%p1 = OpAccessChain %_ptr_PSB_uint %v1 %c0
%u2 = OpAccessChain %_ptr_PC_uint %user_data %c0 %c2
%l2 = OpLoad %uint %u2
%a2 = OpUConvert %ulong %l2
%v2 = OpConvertUToPtr %_ptr_PSB_arr %a2
%p2 = OpAccessChain %_ptr_PSB_uint %v2 %c0
%a = OpLoad %uint %p0 Aligned 4
%b = OpLoad %uint %p1 Aligned 4
%d = OpISub %uint %a %b
OpStore %p2 %d Aligned 4
OpReturn
OpFunctionEnd
